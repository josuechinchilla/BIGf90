Package: BIGf90
Title: Interface to the 'BLUPF90' Programs for Genomic Evaluation and Cross-Validation
Version: 1.0.0
Authors@R: c(
    person("Josue", "Chinchilla-Vargas", role = c("aut", "cre"),
           email = "jc3635@cornell.edu", comment = c(ORCID = "0000-0002-2399-7849")),
    person("Cristiane", "Taniguti", role = "aut",
           comment = c(ORCID = "0000-0002-2021-6883")),
